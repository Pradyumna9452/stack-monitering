        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg(last_over_time({__name__=\"Memory utilization\", site=~\"$site\", host_type=~\"$host_type\"}[5m]))",
          "legendFormat": "Memory %",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg Uptime",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg(last_over_time({__name__=~\"System uptime|Uptime|Uptime \\\\(network\\\\)\", site=~\"$site\", host_type=~\"$host_type\"}[5m])) / 86400",
          "legendFormat": "Uptime",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 7
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 1,
      "type": "table",
      "title": "Device Performance",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "max by(host) (last_over_time({__name__=~\"CPU [Uu]tilization\", host_type=~\"$host_type\", site=~\"$site\"}[5m]))",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "B",
          "expr": "max by(host) (last_over_time({__name__=~\"Memory [Uu]tilization\", host_type=~\"$host_type\", site=~\"$site\"}[5m]))",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "C",
          "expr": "max by(host) (last_over_time({__name__=~\"FS \\\\[.*\\\\]: Space: Used, in %\", host_type=~\"$host_type\", site=~\"$site\"}[5m]))",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "D",
          "expr": "max by(host) (last_over_time({__name__=\"ICMP response time\", host_type=~\"$host_type\", site=~\"$site\"}[5m])) * 1000",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "E",
          "expr": "max by(host) (avg_over_time({__name__=~\"ICMP ping|Zabbix agent availability|Zabbix agent ping\", host_type=~\"$host_type\", site=~\"$site\"}[$__range])) * 100",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "F",
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(group by(host, host_ip, host_type, site, role, host_groups)(last_over_time({host_ip=~\".+\", host_type=~\"$host_type\", site=~\"$site\"}[5m])), \"target\", \"storage-dashboard\", \"host_type\", \"Storage\"), \"target\", \"firewall-dashboard\", \"host_type\", \"Firewall\"), \"target\", \"switch-dashboard\", \"host_type\", \"Switch\"), \"target\", \"server-dashboard\", \"host_type\", \"Server\"), \"target\", \"server-dashboard\", \"target\", \"\")",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "host",
            "mode": "outer"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": [],
            "sort": [
              {
                "field": "Value #A",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "index",
            "alias": "_idx",
            "index": {
              "asPercentile": false
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "Sl. No.",
            "binary": {
              "left": "_idx",
              "operator": "+",
              "right": "1"
            },
            "reduce": {
              "reducer": "sum"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Value #F": true,
              "_idx": true,
              "host_name": true,
              "host_groups": true,
              "host_type": true,
              "role": true,
              "site": true,
              "source": true
            },
            "indexByName": {
              "Sl. No.": 0,
              "host": 1,
              "host_ip": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7,
              "target": 8
            },
            "renameByName": {
              "host": "Hostname",
              "host_ip": "IP Address",
              "Value #A": "CPU Utilization",
              "Value #B": "Memory Utilization",
              "Value #C": "Disk Utilization",
              "Value #D": "Latency",
              "Value #E": "Availability"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true

        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Bandwidth Usage (In / Out)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "last_over_time({\"__name__\"=~\"Interface.*: Bits received\", host=\"$host\", tag_interface=~\"$interface\"}[5m])",
          "legendFormat": "In: {{tag_interface}}",
          "refId": "A"
        },
        {
          "expr": "-last_over_time({\"__name__\"=~\"Interface.*: Bits sent\", host=\"$host\", tag_interface=~\"$interface\"}[5m])",
          "legendFormat": "Out: {{tag_interface}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(ifHCInOctets{device_name=\"$host\"}[5m]) * 8",
          "legendFormat": "SNMP In: {{ifName}}",
          "refId": "C",
          "hide": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "-(rate(ifHCOutOctets{device_name=\"$host\"}[5m]) * 8)",
          "legendFormat": "SNMP Out: {{ifName}}",
          "refId": "D",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "insertNulls": false,
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "barAlignment": 0
          }
        }
      },

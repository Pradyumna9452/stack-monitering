      "targets": [
        {
          "expr": "sum(last_over_time({\"__name__\"=~\"Interface.*: Operational status\", host=\"$host\", tag_interface=~\"$interface\"}[5m]) == bool 1)",
          "legendFormat": "Interfaces Up",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,

    {
      "type": "state-timeline",
      "title": "Interface Up / Down Timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "last_over_time({\"__name__\"=~\"Interface.*: Operational status\", host=\"$host\", tag_interface=~\"$interface\"}[5m])",
          "legendFormat": "{{tag_interface}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "last_over_time(ifOperStatus{device_name=\"$host\"}[5m])",
          "legendFormat": "SNMP: {{ifName}}",
          "refId": "B",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 100,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                },
                "3": {
                  "text": "TESTING",
                  "color": "orange",
                  "index": 2
                },
                "6": {
                  "text": "NOT PRESENT",
                  "color": "#808080",
                  "index": 3
                },
                "7": {
                  "text": "LOWER-LAYER DOWN",
                  "color": "#B877D9",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "perPage": 40,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 9
    },

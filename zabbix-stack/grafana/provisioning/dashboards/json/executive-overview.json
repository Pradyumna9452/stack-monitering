          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "jq-backend",
          "url": "http://zabbix-web:8080/api_jsonrpc.php",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"jsonrpc\": \"2.0\", \"method\": \"problem.get\", \"params\": {\"output\": [\"eventid\"]}, \"id\": 1}"
          },
          "root_selector": "[{\"count\": (.result | length)}]",
          "columns": [
            {
              "selector": "count",
              "text": "Active Alerts",
              "type": "number"
            }
          ]
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"

{
  "uid": "storage-dashboard",
  "title": "Storage Monitoring Dashboard",
  "tags": [
    "storage",
    "zabbix",
    "disk",
    "nas"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 23,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "host",
        "type": "query",
        "label": "Storage Device",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values({host_type=~\".+\", host_type=\"Storage\"}, host)",
        "query": "label_values({host_type=~\".+\", host_type=\"Storage\"}, host)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(last_over_time({__name__=~\"System uptime|Uptime|Device uptime|Uptime \\\\(network\\\\)|Uptime \\\\(hardware\\\\)\", host=~\"$host\"}[15m])) / 86400",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        }
      },
      "id": 30
    },
    {
      "type": "stat",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "avg(last_over_time({\"__name__\"=~\"(?i)(.*memory.*(util|percent).*)\", host=~\"$host\"}[15m]))",
          "legendFormat": "Memory",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        }
      },
      "id": 31
    },
    {
      "type": "stat",
      "title": "ICMP loss",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "avg(last_over_time({\"__name__\"=\"ICMP loss\", host=~\"$host\"}[15m]))",
          "legendFormat": "ICMP loss",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "id": 32
    },
    {
      "type": "stat",
      "title": "Response",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "avg(last_over_time({\"__name__\"=\"ICMP response time\", host=~\"$host\"}[15m]))",
          "legendFormat": "Response",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      },
      "id": 33
    },
    {
      "type": "row",
      "title": "Storage Capacity Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Total Capacity",
      "datasource": {
        "uid": "${datasource}",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(last_over_time({\"__name__\"=~\"(.*DiskCapacity|.*hrStorageSize|pool_size_total|.*VolumeSize|FS.*Space: Total|.*Total size)\", host=~\"$host\"}[15m]))",
          "refId": "A",
          "legendFormat": "Total capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "\u2014"
        }
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Used",
      "datasource": {
        "uid": "${datasource}",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(last_over_time({\"__name__\"=~\"(.*hrStorageUsed|pool_size_used)\", host=~\"$host\"}[15m])) or ((sum(last_over_time({\"__name__\"=~\"(.*DiskCapacity|.*hrStorageSize|pool_size_total|.*VolumeSize|FS.*Space: Total|.*Total size)\", host=~\"$host\"}[15m])) or vector(0)) - (sum(last_over_time({\"__name__\"=~\"(.*hrStorageFree|pool_size_free|FS.*Space: Available|.*Free space)\", host=~\"$host\"}[15m])) or vector(0)) - ((sum(last_over_time({\"__name__\"=~\"(.*VolumeFreeSpace)\", host=~\"$host\"}[15m])) or vector(0)) * 1048576))",
          "refId": "A",
          "legendFormat": "Total used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "\u2014"
        }
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Avg Usage %",
      "datasource": {
        "uid": "${datasource}",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "avg(last_over_time({\"__name__\"=~\"(FS.*Space: Used, in %|.*Usage percent|.*hrStoragePUsed)\", host=~\"$host\"}[15m])) or (((sum(last_over_time({\"__name__\"=~\"(.*DiskCapacity|.*hrStorageSize|pool_size_total|.*VolumeSize|FS.*Space: Total|.*Total size)\", host=~\"$host\"}[15m])) or vector(0)) - (sum(last_over_time({\"__name__\"=~\"(.*hrStorageFree|pool_size_free|FS.*Space: Available|.*Free space)\", host=~\"$host\"}[15m])) or vector(0)) - ((sum(last_over_time({\"__name__\"=~\"(.*VolumeFreeSpace)\", host=~\"$host\"}[15m])) or vector(0)) * 1048576)) / (sum(last_over_time({\"__name__\"=~\"(.*DiskCapacity|.*hrStorageSize|pool_size_total|.*VolumeSize|FS.*Space: Total|.*Total size)\", host=~\"$host\"}[15m])) or vector(0)) * 100)",
          "refId": "A",
          "legendFormat": "Avg usage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "noValue": "\u2014"
        }
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "row",
      "title": "Disk & Partition Usage",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "id": 5
    },
    {
      "type": "bargauge",
      "title": "Partition / Volume Usage (%)",
      "datasource": {
        "uid": "${datasource}",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "last_over_time({\"__name__\"=~\"(FS.*Space: Used, in %|.*Usage percent|.*hrStoragePUsed)\", host=~\"$host\"}[15m])",
          "legendFormat": "{{host}} - {{__name__}}",
          "refId": "A"
        },
        {
          "expr": "(last_over_time({\"__name__\"=~\"(.*VolumeSize|.*Total size)\", host=~\"$host\"}[15m]) - ignoring(__name__) last_over_time({\"__name__\"=~\"(.*VolumeFreeSpace|.*Free space)\", host=~\"$host\"}[15m])) / ignoring(__name__) last_over_time({\"__name__\"=~\"(.*VolumeSize|.*Total size)\", host=~\"$host\"}[15m]) * 100",
          "legendFormat": "{{host}} - {{__name__}}",
          "refId": "B"
        },
        {
          "expr": "(last_over_time({\"__name__\"=~\"(.*DiskCapacity)\", host=~\"$host\"}[15m]) - ignoring(__name__) (last_over_time({\"__name__\"=~\"(.*VolumeFreeSpace)\", host=~\"$host\"}[15m]) * 1048576)) / ignoring(__name__) last_over_time({\"__name__\"=~\"(.*DiskCapacity)\", host=~\"$host\"}[15m]) * 100",
          "legendFormat": "{{host}} - Volume (from DiskCapacity)",
          "refId": "C"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "minVizHeight": 12,
        "minVizWidth": 8,
        "maxVizHeight": 300,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "noValue": "\u2014"
        }
      },
      "id": 6
    },
    {
      "type": "row",
      "title": "Disk Health & Temperature",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 1
      },
      "id": 7
    },
    {
      "type": "stat",
      "title": "Disk Temperatures",
      "datasource": {
        "uid": "${datasource}",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "last_over_time({\"__name__\"=~\"(?i).*disk.*temp.*\", host=~\"$host\"}[15m])",
          "legendFormat": "{{host}} - {{__name__}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "red",
                "value": 55
              }
            ]
          },
          "noValue": "\u2014"
        }
      },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Device & Disk Status",
      "datasource": {
        "uid": "${datasource}",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "last_over_time({\"__name__\"=~\"(ICMP ping|SNMP agent availability|.*[Hh]ealth.*)\", host=~\"$host\"}[15m])",
          "legendFormat": "{{host}} - {{__name__}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP / OK",
                  "color": "green"
                },
                "2": {
                  "text": "UNKNOWN",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "\u2014"
        }
      },
      "id": 9,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "row",
      "title": "Memory",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "id": 10,
      "panels": [
        {
          "type": "gauge",
          "title": "Memory Utilization %",
          "datasource": {
            "uid": "${datasource}",
            "type": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 23,
            "w": 8,
            "h": 7
          },
          "targets": [
            {
              "expr": "last_over_time({\"__name__\"=~\"(?i).*memory.*\", \"__name__\"!~\"(?i).*total memory.*\", host=~\"$host\"}[15m])",
              "legendFormat": "{{host}} - {{__name__}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "color": {
                "mode": "thresholds"
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "orange",
                    "value": 80
                  },
                  {
                    "color": "red",
                    "value": 90
                  }
                ]
              },
              "noValue": "\u2014"
            }
          },
          "id": 11,
          "options": {
            "showThresholdLabels": false,
            "showThresholdMarkers": true,
            "orientation": "auto",
            "sizing": "auto",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            }
          }
        },
        {
          "type": "timeseries",
          "title": "Memory Utilization Trend",
          "datasource": {
            "uid": "${datasource}",
            "type": "prometheus"
          },
          "gridPos": {
            "x": 8,
            "y": 23,
            "w": 16,
            "h": 7
          },
          "targets": [
            {
              "expr": "last_over_time({\"__name__\"=~\"(?i).*memory.*\", \"__name__\"!~\"(?i).*total memory.*\", host=~\"$host\"}[15m])",
              "legendFormat": "{{host}} - {{__name__}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 18,
                "gradientMode": "opacity",
                "showPoints": "never",
                "pointSize": 5,
                "spanNulls": true,
                "insertNulls": false,
                "axisPlacement": "auto",
                "axisColorMode": "text",
                "axisBorderShow": false,
                "axisCenteredZero": false,
                "scaleDistribution": {
                  "type": "linear"
                },
                "stacking": {
                  "mode": "none",
                  "group": "A"
                },
                "hideFrom": {
                  "tooltip": false,
                  "viz": false,
                  "legend": false
                },
                "thresholdsStyle": {
                  "mode": "off"
                },
                "barAlignment": 0
              },
              "color": {
                "mode": "palette-classic"
              }
            }
          },
          "id": 12,
          "options": {
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            },
            "legend": {
              "displayMode": "table",
              "placement": "bottom",
              "showLegend": true,
              "calcs": [
                "lastNotNull",
                "max",
                "mean"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Fans & Environment",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "id": 13,
      "panels": [
        {
          "type": "timeseries",
          "title": "Fan Speed (RPM)",
          "datasource": {
            "uid": "${datasource}",
            "type": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 31,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "expr": "last_over_time({\"__name__\"=~\"(?i)(.*fan.*rpm|.*fan.*speed|.*fanspeed)\", host=~\"$host\"}[15m])",
              "legendFormat": "{{host}} - {{__name__}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "rotrpm",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 18,
                "gradientMode": "opacity",
                "showPoints": "never",
                "pointSize": 5,
                "spanNulls": true,
                "insertNulls": false,
                "axisPlacement": "auto",
                "axisColorMode": "text",
                "axisBorderShow": false,
                "axisCenteredZero": false,
                "scaleDistribution": {
                  "type": "linear"
                },
                "stacking": {
                  "mode": "none",

    {
      "id": 1,
      "type": "stat",
      "title": "Avg CPU Utilization",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg(last_over_time({__name__=\"CPU utilization\", host=~\"$host\", site=~\"$site\", host_type=~\"$host_type\"}[5m]))",
          "legendFormat": "CPU %",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false

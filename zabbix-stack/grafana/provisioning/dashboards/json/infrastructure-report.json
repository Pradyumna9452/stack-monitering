    "native",
    "report",
    "sla",
    "availability"
  ],
  "schemaVersion": 39,
  "version": 6,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {
          "text": "VictoriaMetrics",
          "value": "victoriametrics"
        },
        "refresh": 1,
        "hide": 0,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "site",
        "type": "query",
        "label": "Site",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(site)",
        "query": {
          "query": "label_values(site)",
          "refId": "site"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0,
        "regex": ""
      },
      {
        "name": "host_type",
        "type": "query",
        "label": "Type",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values({site=~\"$site\"}, host_type)",
        "query": {
          "query": "label_values({site=~\"$site\"}, host_type)",
          "refId": "host_type"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0,
        "regex": ""
      },
      {
        "name": "host",
        "type": "query",
        "label": "Host",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values({site=~\"$site\", host_type=~\"$host_type\"}, host)",
        "query": {
          "query": "label_values({site=~\"$site\", host_type=~\"$host_type\"}, host)",
          "refId": "host"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "hide": 0,
        "regex": ""
      }
    ]
  },

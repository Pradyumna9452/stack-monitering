{
  "id": null,
  "uid": "device-performance-status",
  "title": "Overall Device Status",
  "tags": [
    "zabbix",
    "status",
    "performance"
  ],
  "style": "dark",
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {},
  "schemaVersion": 38,
  "version": 1,
  "links": [
    {
      "title": "Host Availability Report",
      "url": "/grafana/d/host-availability-report",
      "type": "link",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "host_group",
        "type": "query",
        "label": "Host Group",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(host_groups)",
        "regex": "/,(.+),/",
        "allValue": ".*",
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "refresh": 2
      },
      {
        "name": "site",
        "type": "query",
        "label": "Site",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(site)",
        "allValue": ".*",
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "refresh": 2
      },
      {
        "name": "host_type",
        "type": "query",
        "label": "Device Type",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(host_type)",
        "allValue": ".*",
        "includeAll": true,
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "refresh": 2
      },
      {
        "name": "host",
        "type": "query",
        "label": "Host",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values({host_type=~\".+\", host_groups=~\".*$host_group.*\", host_type=~\"$host_type\", site=~\"$site\"}, host)",
        "allValue": ".+",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet Summary",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
